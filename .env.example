# =============================================================================
# Plantilla de Variables de Entorno — AI Cost Router (Docker Compose)
# =============================================================================
# Copia este archivo como `.env` en la raíz del proyecto antes de ejecutar
# `docker compose up --build` para personalizar credenciales y cuotas.
# NUNCA subas el archivo `.env` real con secretos al control de versiones.
# =============================================================================

# --- Credenciales de Base de Datos PostgreSQL 17 ---
POSTGRES_DB=airouterdb
POSTGRES_USER=airouter_user
POSTGRES_PASSWORD=airouter_secret_pwd

# --- Proveedor LLM Externo (Opcional: si se deja vacío opera en modo simulado) ---
GEMINI_API_KEY=

# --- Parámetros de Seguridad (Rate Limiting y CORS) ---
AIROUTER_RATE_LIMIT_RPM=20
AIROUTER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
